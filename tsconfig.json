{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": ["core-ecs", "world-gen", "game-sim", "network", "server", "client", "renderer-orbit", "renderer-isometric", "tests", "scripts", "vite.config.ts", "vitest.config.ts"]
}
